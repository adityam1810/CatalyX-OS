#!/bin/bash

CONFIG="/etc/distro/config"

if [ -f "$CONFIG" ]; then
    source "$CONFIG"
fi

storage_header() {
    echo
    echo "================================"
    echo "        $OS_NAME STORAGE"
    echo "================================"
    echo
}

storage_status() {
    storage_header

    echo "Filesystem usage:"
    df -h

    echo
    echo "Block devices:"
    lsblk
}

storage_disks() {
    echo "=== BLOCK DEVICES ==="
    echo
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
    echo
}

storage_usage() {
    echo "=== FILESYSTEM USAGE ==="
    echo
    df -hT
    echo
}

storage_mounts() {
    echo "=== MOUNTED FILESYSTEMS ==="
    echo
    findmnt
    echo
}

storage_filesystem() {
    echo "=== FILESYSTEM INFORMATION ==="
    echo
    df -hT
    echo
}

storage_memory() {
    echo "=== MEMORY / SWAP ==="
    echo
    free -h
    echo
}

case "$1" in

    ""|status|info)
        storage_status
        ;;

    disks)
        storage_disks
        ;;

    usage)
        storage_usage
        ;;

    mounts)
        storage_mounts
        ;;

    filesystem|filesystems)
        storage_filesystem
        ;;

    memory)
        storage_memory
        ;;

    *)
        echo "Usage:"
        echo "  storage"
        echo "  storage status"
        echo "  storage disks"
        echo "  storage usage"
        echo "  storage mounts"
        echo "  storage filesystem"
        echo "  storage memory"
        exit 1
        ;;

esac
