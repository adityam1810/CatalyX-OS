#!/bin/bash

CONFIG="/etc/distro/config"

if [ -f "$CONFIG" ]; then
    source "$CONFIG"
fi

users_header() {
    echo
    echo "================================"
    echo "          $OS_NAME USERS"
    echo "================================"
    echo
}

users_current() {
    echo "=== CURRENT USER ==="
    echo
    echo "Username:"
    whoami

    echo
    echo "User ID:"
    id

    echo
    echo "Groups:"
    groups

    echo
}

users_list() {
    echo "=== USER ACCOUNTS ==="
    echo

    awk -F: '$7 !~ /(nologin|false)$/ {print $1 " -> " $7}' /etc/passwd

    echo
}

users_groups() {
    echo "=== GROUPS ==="
    echo

    cut -d: -f1 /etc/group

    echo
}

users_sudo() {
    echo "=== SUDO STATUS ==="
    echo

    CURRENT_USER=$(whoami)

    if groups "$CURRENT_USER" 2>/dev/null | grep -qw sudo; then
        echo "Current user has sudo privileges."
    else
        echo "Current user does not have sudo privileges."
    fi

    echo
}

users_sessions() {
    echo "=== LOGGED-IN USERS ==="
    echo

    who

    echo
}

users_home() {
    echo "=== USER HOME DIRECTORIES ==="
    echo

    awk -F: '$6 != "" && $6 != "/" {print $1 " -> " $6}' /etc/passwd

    echo
}

users_status() {
    users_header

    users_current
    users_sudo
    users_sessions
}

case "$1" in

    ""|info|status)
        users_status
        ;;

    current)
        users_current
        ;;

    list)
        users_list
        ;;

    groups)
        users_groups
        ;;

    sudo)
        users_sudo
        ;;

    sessions|who)
        users_sessions
        ;;

    home)
        users_home
        ;;

    *)
        echo "Usage:"
        echo "  users"
        echo "  users status"
        echo "  users current"
        echo "  users list"
        echo "  users groups"
        echo "  users sudo"
        echo "  users sessions"
        echo "  users home"
        exit 1
        ;;

esac
