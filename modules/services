#!/bin/bash

CONFIG="/etc/distro/config"

if [ -f "$CONFIG" ]; then
    source "$CONFIG"
fi

case "$1" in

    info|"")
        echo "================================"
        echo "        $OS_NAME SERVICES"
        echo "================================"
        echo

        echo "Systemd:"
        systemctl --version | head -n 1

        echo
        echo "Failed services:"
        systemctl --failed --no-pager

        echo
        echo "Running services:"
        systemctl list-units --type=service --state=running --no-pager
        ;;

    running)
        echo "=== RUNNING SERVICES ==="
        systemctl list-units --type=service --state=running --no-pager
        ;;

    failed)
        echo "=== FAILED SERVICES ==="
        systemctl --failed --no-pager
        ;;

    enabled)
        echo "=== ENABLED SERVICES ==="
        systemctl list-unit-files --type=service --state=enabled --no-pager
        ;;

    status)
        if [ -z "$2" ]; then
            echo "Usage: $CLI_NAME services status <service>"
            exit 1
        fi

        echo "=== SERVICE STATUS: $2 ==="
        systemctl status "$2" --no-pager
        ;;

    *)
        echo "Usage: $CLI_NAME services [info|running|failed|enabled|status]"
        ;;

esac
