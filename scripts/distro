#!/bin/bash

CONFIG="/etc/distro/config"
MODULE_DIR="/usr/local/lib/distro/modules"

if [ -f "$CONFIG" ]; then
    source "$CONFIG"
else
    OS_NAME="Linux Distribution"
    CLI_NAME="distro"
    VERSION="0.1"
    CODENAME="Development"
    BASE="Debian"
    TYPE="CLI"
fi

PROGRAM="$(basename "$0")"

# Determine command
if [ "$PROGRAM" = "distro" ] || [ "$PROGRAM" = "catalyx" ]; then
    COMMAND="$1"
else
    COMMAND="$PROGRAM"
fi

case "$COMMAND" in

    help|"")
        echo "================================"
        echo "          $OS_NAME"
        echo "================================"
        echo
        echo "Usage: distro <command>"
        echo
        echo "Core Commands:"
        echo "  help             Show this help"
        echo "  about            Show OS information"
        echo "  version          Show OS version"
        echo
        echo "System Modules:"
        echo "  system           System information"
        echo "  network          Network information"
        echo "  cloud            Cloud tools and status"
        echo "  security         Security information"
        echo "  devops           DevOps tools and status"
        echo "  services         System services"
        echo "  storage          Storage information"
        echo "  users            User information"
        echo
        echo "Package Manager:"
        echo "  modi             MODI package manager"
        echo
        echo "Examples:"
        echo "  distro about"
        echo "  distro network"
        echo "  distro cloud"
        echo "  distro users list"
        echo "  modi search curl"
        echo
        ;;

    about)
        echo
        echo "=========================================="
        echo "              $OS_NAME"
        echo "=========================================="
        echo
        echo " Version       : $VERSION"
        echo " Codename      : $CODENAME"
        echo " Base          : $BASE"
        echo " Architecture  : $(uname -m)"
        echo " Kernel        : $(uname -r)"
        echo " Hostname      : $(hostname)"
        echo " Uptime        : $(uptime -p)"
        echo
        echo " Cloud         : Available"
        echo " Security      : Available"
        echo " DevOps        : Available"
        echo
        echo "=========================================="
        echo
        ;;

    version)
        echo "$OS_NAME $VERSION ($CODENAME)"
        ;;

    modi)
        MODULE="$MODULE_DIR/packages"

        if [ -x "$MODULE" ]; then
            "$MODULE" "$2" "$3" "$4"
        else
            echo "MODI package module not found."
            exit 1
        fi
        ;;

    *)
        MODULE="$MODULE_DIR/$COMMAND"

        if [ -f "$MODULE" ] && [ -x "$MODULE" ]; then
            "$MODULE" "$2" "$3" "$4"
        else
            echo "$CLI_NAME: unknown command '$COMMAND'"
            echo "Run 'distro help' for available commands."
            exit 1
        fi
        ;;

esac
